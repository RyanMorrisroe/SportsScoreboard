{
  "name": "sports-scoreboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm test && node ./scripts/build.mjs",
    "serve": "vite --host 0.0.0.0 --port 8000 --strictPort",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:live": "vitest run tests/live",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "latest",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2"
  }
}
